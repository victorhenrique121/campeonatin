# ==============================================================================
# FC Arena — Supabase (Etapa 1: somente conexão; SQLite continua sendo o banco
# principal do aplicativo).
#
# Como usar:
#   1. Copie este arquivo para `.env` (mesmo diretório, raiz do projeto).
#   2. Preencha com os valores do SEU projeto Supabase:
#      Dashboard > Project Settings > API (URL e chave pública "anon").
#   3. Rode `npm run dev` — o status da conexão aparece no console do processo
#      main com o prefixo [supabase].
#
# O `.env` está no .gitignore: NUNCA commite chaves.
# Estas variáveis são usadas APENAS no processo main do Electron e nunca são
# expostas ao renderer.
# ==============================================================================

# URL do projeto Supabase (ex.: https://abcdefghijkl.supabase.co)
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave PÚBLICA (anon / publishable key). É segura para uso em clientes porque
# o acesso aos dados é protegido por Supabase Auth + Row Level Security (RLS).
SUPABASE_ANON_KEY=sua-chave-anon-publica

# ⚠️ NÃO adicione SUPABASE_SERVICE_ROLE_KEY aqui (nem em lugar nenhum do
# aplicativo distribuído). O código do FC Arena a ignora de propósito e exibe
# um aviso se ela estiver presente no ambiente.
