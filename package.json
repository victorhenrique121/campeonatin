{
  "name": "fc-arena",
  "version": "0.1.0",
  "private": true,
  "author": {
    "name": "Victor Henrique",
    "email": "victor.henrique@example.com"
  },
  "description": "Gerenciador desktop de campeonatos EA Sports FC",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "tsc -p tsconfig.electron.json && wait-on tcp:5173 && electron .",
    "build": "tsc -p tsconfig.electron.json && vite build && electron-builder --publish never",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --root .",
    "migrate": "node scripts/migrate-to-supabase.mjs",
    "migrate:players": "node scripts/migrate-players-to-supabase.mjs",
    "migrate:teams": "node scripts/migrate-teams-to-supabase.mjs",
    "migrate:matches": "node scripts/migrate-matches-to-supabase.mjs",
    "migrate:champions": "node scripts/migrate-champions-to-supabase.mjs",
    "test:stage2": "node scripts/dev-tests/run-stage2-tests.cjs",
    "generate:icon": "node scripts/generate-icon.mjs",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "premake": "node scripts/generate-supabase-env.mjs",
    "make": "electron-forge make"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@vitejs/plugin-react": "6.0.4",
    "better-sqlite3": "13.0.1",
    "csv-parser": "^3.2.1",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "1.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/preset-typescript": "^7.29.7",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "concurrently": "^10.0.5",
    "electron": "^43.2.0",
    "eslint": "^9.39.4",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "supabase": "^2.121.0",
    "typescript": "7.0.2",
    "vitest": "^4.0.18",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.fcarena.desktop",
    "productName": "FC Arena",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/midia/fcarena.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/midia/icon.ico"
    }
  }
}
