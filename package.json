{
  "name": "fc-arena",
  "version": "0.1.0",
  "private": true,
  "description": "Gerenciador desktop de campeonatos EA Sports FC",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "build": "tsc -p tsconfig.electron.json && vite build && electron-builder",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.4",
    "better-sqlite3": "13.0.1",
    "csv-parser": "^3.2.1",
    "lucide-react": "1.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "concurrently": "10.0.3",
    "electron": "^43.2.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.fcarena.desktop",
    "productName": "FC Arena",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
